# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:3000
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OperAGI <noreply@localhost>
ACCOUNT_EMAIL_VERIFICATION=mandatory

# PostgreSQL (only used when DOCKER_ENV=1)
DOCKER_ENV=
DB_NAME=operagi
DB_USER=operagi
DB_PASSWORD=operagi
DB_HOST=db
DB_PORT=5432

# Generation defaults to deterministic local mode and needs no API key.
CONTENT_GENERATION_PROVIDER=local
CONTENT_GENERATION_MODEL=gpt-4o-mini
CONTENT_GENERATION_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SOCIAL_PUBLISH_MODE=simulate

# Optional Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# OAuth is optional for local MVP operation
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Nuxt
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
